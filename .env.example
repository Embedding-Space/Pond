# Pond Docker Compose Environment Variables
# Copy this file to .env and update with your values

# Postgres Configuration (used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=pond
POSTGRES_PORT=5432

# Pond API Configuration
POND_PORT=8000
POND_API_KEY=your-api-key-here
LOG_LEVEL=INFO
LOG_FORMAT=json

# Ollama Configuration (running on host machine)
OLLAMA_URL=http://host.docker.internal:11434
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_TIMEOUT=60

# B2 Backup Configuration
B2_APPLICATION_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=your-bucket-name

# Optional: Other settings
POND_TIMEZONE=America/Los_Angeles
DB_POOL_SIZE=10